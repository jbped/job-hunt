%!PS-Adobe-3.0
%%Pages: 1
%%BoundingBox: 0 0 612 792
%%EndComments

<< /PageSize [612 792] >> setpagedevice
[ /Title ({{FULL_NAME}} - {{POSITION}} Cover Letter)
  /Author ({{FULL_NAME}})
  /Subject (Application for {{POSITION}} at {{COMPANY}})
  /DOCINFO pdfmark

/HB /Helvetica-Bold findfont def
/HR /Helvetica findfont def
/brand { 0.045 0.235 0.56 setrgbcolor } def
/ink { 0.08 0.08 0.08 setrgbcolor } def
/muted { 0.28 0.28 0.28 setrgbcolor } def
/Rshow { dup stringwidth pop neg 0 rmoveto show } def
/line {
  /txt exch def /y exch def
  HR 9.2 scalefont setfont ink 38 y moveto txt show
} def
/contact {
  /txt exch def /y exch def
  HR 7.8 scalefont setfont muted 548 y moveto txt Rshow
} def
/phoneIcon {
  gsave translate brand 1.35 setlinewidth 1 setlinecap 1 setlinejoin
  newpath 2.2 11.5 moveto 1.1 10.8 0.9 9.4 1.4 8.2 curveto
  3.1 4.2 6.3 1.1 10.2 0.6 curveto 11.5 0.45 12.6 1.3 12.7 2.4 curveto
  12.7 3.2 12.1 3.8 11.3 4.4 curveto 10.8 4.8 10.1 4.7 9.6 4.2 curveto
  8.9 3.6 8.2 3.4 7.3 3.9 curveto 5.8 4.7 4.4 6.1 3.7 7.6 curveto
  3.3 8.4 3.5 9.2 4.1 9.8 curveto 4.7 10.4 4.7 11.1 4.2 11.7 curveto
  3.6 12.4 2.9 12.2 2.2 11.5 curveto stroke grestore
} def
/pinIcon {
  gsave translate brand newpath 6.5 0 moveto 5.1 2.1 2.1 5.9 2.1 8.2 curveto
  2.1 10.7 4.0 12.6 6.5 12.6 curveto 9.0 12.6 10.9 10.7 10.9 8.2 curveto
  10.9 5.9 7.9 2.1 6.5 0 curveto closepath fill
  1 1 1 setrgbcolor newpath 6.5 8.3 1.65 0 360 arc fill grestore
} def
/mailIcon {
  gsave translate brand 1.15 setlinewidth 1 setlinejoin
  newpath 1 2 moveto 12 2 lineto 12 10.5 lineto 1 10.5 lineto closepath stroke
  newpath 1.4 10.1 moveto 6.5 6.2 lineto 11.6 10.1 lineto stroke
  newpath 1.4 2.4 moveto 5.0 6.0 lineto stroke
  newpath 11.6 2.4 moveto 8.0 6.0 lineto stroke grestore
} def
/linkedinIcon {
  gsave translate brand newpath 0.5 0.5 moveto 12.5 0.5 lineto 12.5 12.5 lineto 0.5 12.5 lineto closepath fill
  /Helvetica-Bold findfont 7.1 scalefont setfont 1 1 1 setrgbcolor 2.1 3.2 moveto (in) show grestore
} def

brand
HB 18.5 scalefont setfont 38 756 moveto ({{NAME_LINE_1}}) show
38 735 moveto ({{NAME_LINE_2}}) show
HR 8.6 scalefont setfont muted 38 718 moveto ({{PROFESSIONAL_TITLE}}) show
756 ({{PHONE}}) contact
742 ({{LOCATION}}) contact
728 ({{EMAIL}}) contact
714 ({{LINKEDIN_DISPLAY}}) contact
556 752 phoneIcon
556 738 pinIcon
556 724 mailIcon
556 710 linkedinIcon
brand 38 703 moveto 570 703 lineto 0.9 setlinewidth stroke

HR 9.2 scalefont setfont ink
38 681 moveto ({{DATE}}) show
38 655 moveto ({{RECIPIENT}}) show
38 642 moveto ({{COMPANY}}) show
38 629 moveto ({{LOCATION_LINE}}) show

HB 10 scalefont setfont brand 38 603 moveto (RE: {{POSITION_UPPER}}) show
HR 9.2 scalefont setfont ink
38 578 moveto (Dear {{SALUTATION}},) show

556 ({{OPENING_LINE_1}}) line
543 ({{OPENING_LINE_2}}) line
530 ({{OPENING_LINE_3}}) line
517 ({{OPENING_LINE_4}}) line

491 ({{PARAGRAPH_2_LINE_1}}) line
478 ({{PARAGRAPH_2_LINE_2}}) line
465 ({{PARAGRAPH_2_LINE_3}}) line
452 ({{PARAGRAPH_2_LINE_4}}) line
439 ({{PARAGRAPH_2_LINE_5}}) line
426 ({{PARAGRAPH_2_LINE_6}}) line

400 ({{PARAGRAPH_3_LINE_1}}) line
387 ({{PARAGRAPH_3_LINE_2}}) line
374 ({{PARAGRAPH_3_LINE_3}}) line
361 ({{PARAGRAPH_3_LINE_4}}) line

335 ({{PARAGRAPH_4_LINE_1}}) line
322 ({{PARAGRAPH_4_LINE_2}}) line
309 ({{PARAGRAPH_4_LINE_3}}) line
296 ({{PARAGRAPH_4_LINE_4}}) line
283 ({{PARAGRAPH_4_LINE_5}}) line

257 ({{PARAGRAPH_5_LINE_1}}) line
244 ({{PARAGRAPH_5_LINE_2}}) line
231 ({{PARAGRAPH_5_LINE_3}}) line
218 ({{PARAGRAPH_5_LINE_4}}) line
205 ({{PARAGRAPH_5_LINE_5}}) line

179 ({{CLOSING_LINE_1}}) line
166 ({{CLOSING_LINE_2}}) line
153 ({{CLOSING_LINE_3}}) line

HR 9.2 scalefont setfont ink 38 121 moveto (Sincerely,) show
HB 10 scalefont setfont brand 38 92 moveto ({{FULL_NAME}}) show

showpage
%%EOF
