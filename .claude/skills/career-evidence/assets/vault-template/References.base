filters:
  and:
    - note.type == "professional-reference"
properties:
  note.name:
    displayName: Name
  note.status:
    displayName: Consent
  note.relationship:
    displayName: Relationship
  note.email:
    displayName: Email
  note.phone:
    displayName: Phone
  note.preferred_contact_method:
    displayName: Prefers
views:
  - type: table
    name: Confirmed
    filters:
      and:
        - note.status == "confirmed"
    order:
      - note.name
      - note.relationship
      - note.email
      - note.preferred_contact_method
  - type: table
    name: Awaiting consent
    filters:
      and:
        - note.status != "confirmed"
    order:
      - note.name
      - note.status
      - note.relationship
  - type: table
    name: All
    order:
      - note.name
      - note.status
      - note.relationship
      - note.email
