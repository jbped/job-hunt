# Copy to .env and point at your Obsidian vault.
# A vault is any directory containing both "Job Hunt Dashboard.md" and "Career Evidence/".
# Create one with: python .agents/skills/career-evidence/scripts/init_vault.py ~/Documents/Obsidian/job-hunt

CAREER_EVIDENCE_VAULT=~/Documents/Obsidian/job-hunt

# Port for the local dashboard (scripts/serve.py --port overrides this).
CAREER_EVIDENCE_PORT=8765
