.env
dist/
# The default in-repo vault: personal data, never committed.
/vault/
# Built by demo/build_demo.py; only the builder is committed.
/demo/vault/
__pycache__/
*.pyc
.cache/
# Personal skill installs; only the canonical career-evidence set is tracked.
/.agents/skills/*
!/.agents/skills/career-evidence/
!/.agents/skills/cover-letter-pdf/
!/.agents/skills/cross-check/
!/.agents/skills/draft-cover-letter/
!/.agents/skills/draft-resume/
!/.agents/skills/init-vault/
!/.agents/skills/new-application/
!/.agents/skills/new-person/
!/.agents/skills/resume-pdf/
/.claude/skills/*
!/.claude/skills/career-evidence
!/.claude/skills/cover-letter-pdf
!/.claude/skills/cross-check
!/.claude/skills/draft-cover-letter
!/.claude/skills/draft-resume
!/.claude/skills/init-vault
!/.claude/skills/new-application
!/.claude/skills/new-person
!/.claude/skills/resume-pdf
/skills-lock.json

# The React frontend workspace; the built bundle in server/assets/ui/ is committed.
ui/node_modules/

# design-sync working state. The durable inputs under ui/.design-sync/
# (config.json, NOTES.md, conventions.md, previews/) ARE committed;
# .cache/ is already covered by the global rule above.
ui/.ds-sync/
ui/ds-bundle/
ui/.design-sync/learnings/
ui/.design-sync/node_modules
