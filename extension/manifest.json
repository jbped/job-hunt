{
  "manifest_version": 3,
  "name": "Job Hunt Capture",
  "version": "0.1.0",
  "description": "One-click capture of the job posting you are looking at, into your local job-hunt vault.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Capture this posting"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["http://127.0.0.1/*"],
  "browser_specific_settings": {
    "gecko": {
      "id": "job-hunt-capture@jbped.github.io",
      "strict_min_version": "115.0"
    }
  }
}
