filters:
  and:
    - note.type == "person"
properties:
  note.name:
    displayName: Name
  note.reference_status:
    displayName: Consent
  note.relationships:
    displayName: Job-search roles
  note.professional_relationships:
    displayName: Professional relationships
  note.company_context:
    displayName: Company
  note.via:
    displayName: Via
  note.email:
    displayName: Email
  note.phone:
    displayName: Phone
  note.preferred_contact_method:
    displayName: Prefers
views:
  - type: table
    name: Network
    filters:
      and:
        - file.inFolder("People/Network")
    order:
      - name
      - professional_relationships
      - company_context
      - email
      - preferred_contact_method
  - type: table
    name: Recruiters
    filters:
      and:
        - file.inFolder("People/Recruiters")
    order:
      - name
      - company_context
      - email
      - preferred_contact_method
  - type: table
    name: Job Hunt
    filters:
      and:
        - file.inFolder("People/Job Hunt")
    order:
      - name
      - relationships
      - via
      - company_context
      - preferred_contact_method
  - type: table
    name: Confirmed references
    filters:
      and:
        - note.reference_status == "confirmed"
    order:
      - name
      - company_context
      - email
      - preferred_contact_method
  - type: table
    name: Awaiting consent
    filters:
      and:
        - note.reference_status != null
        - note.reference_status != "confirmed"
    order:
      - name
      - reference_status
      - company_context
  - type: table
    name: All
    order:
      - name
      - professional_relationships
      - relationships
      - reference_status
      - company_context
      - email
